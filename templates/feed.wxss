.masthead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0 20rpx;
  border-bottom: 1rpx solid #dedfd6;
}

.jade-logo {
  width: 96rpx;
  height: 118rpx;
  flex: none;
}

.brand-copy {
  min-width: 0;
}

.brand-kicker {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #8a8b82;
}

.site-title {
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.3;
  color: #292b25;
}

.brand-scope {
  font-size: 23rpx;
  color: #66695f;
  margin-top: 4rpx;
}

.snapshot {
  font-size: 21rpx;
  color: #8a8b82;
  margin-top: 8rpx;
}

.quick-links {
  display: flex;
  gap: 24rpx;
  padding: 18rpx 0;
}

.quick-link {
  font-size: 25rpx;
  color: #a83d30;
  border-bottom: 2rpx solid #a83d30;
  padding-bottom: 4rpx;
}

.search-box {
  background: #edeee7;
  border-radius: 6rpx;
  padding: 0 20rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
}

.search-input {
  width: 100%;
  font-size: 28rpx;
  color: #292b25;
}

.placeholder {
  color: #999b92;
}

.topic-row {
  white-space: nowrap;
  width: 100%;
  margin: 20rpx 0 8rpx;
}

.topic {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 6rpx;
  font-size: 25rpx;
  color: #66695f;
  background: #edeee7;
  min-height: 44rpx;
}

.topic.active {
  color: #ffffff;
  background: #a83d30;
}

.filter-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  font-size: 27rpx;
  color: #292b25;
}

.filter-hint {
  font-size: 23rpx;
  color: #a83d30;
}

.filter-panel {
  background: #efeee8;
  border-radius: 8rpx;
  padding: 8rpx 20rpx 20rpx;
  margin-bottom: 16rpx;
}

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 80rpx;
  border-bottom: 1rpx solid #dedfd6;
  font-size: 26rpx;
}

.filter-value {
  color: #a83d30;
  max-width: 60%;
  text-align: right;
}

.filter-reset {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #66695f;
  padding: 16rpx;
  border: 1rpx solid #dedfd6;
  border-radius: 6rpx;
}

.export-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #dedfd6;
}

.result-count {
  font-size: 23rpx;
  color: #66695f;
}

.export-actions {
  display: flex;
  gap: 20rpx;
}

.text-link {
  font-size: 23rpx;
  color: #a83d30;
}

.state-card {
  padding: 80rpx 20rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 30rpx;
  color: #292b25;
}

.state-description {
  display: block;
  font-size: 25rpx;
  color: #66695f;
  margin-top: 12rpx;
}

.outline-button {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 32rpx;
  border: 1rpx solid #a83d30;
  border-radius: 6rpx;
  color: #a83d30;
  font-size: 26rpx;
}

.day-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 0 12rpx;
}

.day-year {
  font-size: 21rpx;
  color: #8a8b82;
}

.day-text {
  font-size: 25rpx;
  color: #66695f;
}

.day-rule {
  flex: 1;
  height: 1rpx;
  background: #dedfd6;
}

.news-item {
  padding: 24rpx 0 28rpx;
  border-bottom: 1rpx solid #dedfd6;
}

.news-item.is-read .news-title {
  color: #77796f;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.kind {
  font-size: 21rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  color: #ffffff;
}

.kind-incident { background: #a83d30; }
.kind-advisory { background: #a9761c; }
.kind-research { background: #4f6546; }

.meta-source, .meta-date, .compilation {
  font-size: 21rpx;
  color: #66695f;
}

.compilation {
  color: #8a8b82;
}

.aso {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  color: #ffffff;
}

.aso-high { background: #a83d30; }
.aso-mid { background: #a9761c; }
.aso-low { background: #3c5a80; }

.news-title {
  font-size: 38rpx;
  line-height: 1.5;
  font-weight: 500;
  color: #292b25;
}

.news-summary {
  font-size: 29rpx;
  line-height: 1.65;
  color: #4b4d45;
  margin-top: 12rpx;
}

.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  font-size: 21rpx;
  color: #66695f;
  background: #edeee7;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

.copy-link {
  flex: none;
  font-size: 22rpx;
  color: #a83d30;
}

.site-footer {
  padding: 40rpx 0 20rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #8a8b82;
  text-align: center;
}
