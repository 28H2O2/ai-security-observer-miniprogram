.page-title {
  font-size: 44rpx;
  font-weight: 500;
  padding: 30rpx 0 8rpx;
}

.intro {
  font-size: 26rpx;
  line-height: 1.7;
  color: #66695f;
  margin-bottom: 24rpx;
}

.search-box {
  background: #edeee7;
  border-radius: 6rpx;
  padding: 0 20rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
}

.search-input {
  width: 100%;
  font-size: 28rpx;
}

.placeholder {
  color: #999b92;
}

.search-count {
  font-size: 22rpx;
  color: #8a8b82;
  padding: 16rpx 0;
}

.state-card {
  padding: 80rpx 20rpx;
  text-align: center;
}

.state-title {
  font-size: 30rpx;
}

.outline-button {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 32rpx;
  border: 1rpx solid #a83d30;
  border-radius: 6rpx;
  color: #a83d30;
  font-size: 26rpx;
}

.source-group {
  margin-bottom: 26rpx;
  background: #efeee8;
  border-radius: 18rpx;
  padding: 22rpx 20rpx;
}

.group-head {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.group-count {
  font-size: 22rpx;
  color: #8a8b82;
  font-weight: 400;
}

.source-nodes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.source-node {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 72rpx;
  padding: 12rpx 18rpx;
  background: #ffffff;
  border-radius: 10rpx;
}

.source-name {
  font-size: 25rpx;
  color: #292b25;
}

.source-count {
  font-size: 20rpx;
  color: #8a8b82;
}

.source-detail {
  margin-top: 30rpx;
  padding: 26rpx 24rpx;
  background: #efe4dd;
  border-radius: 12rpx;
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.method {
  font-size: 20rpx;
  color: #8a8b82;
  letter-spacing: 1rpx;
}

.detail-title {
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 500;
  margin-top: 6rpx;
}

.close {
  font-size: 24rpx;
  color: #a83d30;
  flex: none;
  padding: 8rpx;
}

.description {
  font-size: 26rpx;
  line-height: 1.7;
  color: #4b4d45;
  margin-top: 16rpx;
}

.detail-links {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.detail-link {
  font-size: 25rpx;
  color: #a83d30;
}

.status {
  font-size: 21rpx;
  color: #8a8b82;
  margin-top: 20rpx;
}

.notes-title {
  font-size: 24rpx;
  color: #292b25;
  margin-top: 24rpx;
}

.notes {
  font-size: 24rpx;
  line-height: 1.7;
  color: #66695f;
  margin-top: 8rpx;
}

.more-card {
  margin-top: 36rpx;
  padding: 24rpx 20rpx;
  background: #efeee8;
  border-radius: 12rpx;
}

.more-title {
  font-size: 22rpx;
  color: #8a8b82;
  margin-bottom: 8rpx;
}

.more-link {
  font-size: 26rpx;
  color: #a83d30;
  padding: 12rpx 0;
}

.site-footer {
  padding: 40rpx 0 20rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #8a8b82;
  text-align: center;
}
