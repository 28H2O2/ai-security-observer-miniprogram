/* 列表页样式：调色板与语义规则见 app.wxss 顶部注释
   全工程只有一个强调色（朱红），其余均为纸色灰阶 */

.masthead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0 20rpx;
}

/* LOGO 放大，作为品牌区视觉重心 */
.jade-logo {
  width: 88rpx;
  height: 108rpx;
  flex: none;
}

.brand-copy {
  min-width: 0;
}

.site-title {
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.3;
  color: #292b25;
}

.snapshot {
  font-size: 20rpx;
  color: #8a8b82;
  margin-top: 6rpx;
}

/* 搜索与筛选收进品牌行右侧的放大镜 icon：默认中性灰，
   浮层打开或已有筛选条件时变朱红（当前选中 / 可点击语义） */
.search-icon {
  position: relative;
  flex: none;
  margin-left: auto;
  width: 64rpx;
  height: 72rpx;
}

.search-lens {
  position: absolute;
  top: 22rpx;
  left: 18rpx;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #8a8b82;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-handle {
  position: absolute;
  top: 42rpx;
  left: 37rpx;
  width: 14rpx;
  height: 3rpx;
  background: #8a8b82;
  transform: rotate(45deg);
}

.search-icon.is-active .search-lens {
  border-color: #a83d30;
}

.search-icon.is-active .search-handle {
  background: #a83d30;
}

/* 主题：换行排列，不再横向滚动（避免预览里的滚动条）；
   选中态只用朱红边框与文字，不铺色块 */
.topic-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 14rpx;
}

.topic {
  flex: none;
  padding: 8rpx 18rpx;
  border: 1rpx solid #dedfd6;
  border-radius: 6rpx;
  font-size: 23rpx;
  color: #5c5f56;
  background: #ffffff;
}

.topic.active {
  color: #a83d30;
  border-color: #a83d30;
  font-weight: 500;
}

/* 点击 icon 后浮出的卡片：白底 + 细边框 + 淡阴影，不占首屏 */
.filter-sheet {
  background: #ffffff;
  border: 1rpx solid #dedfd6;
  border-radius: 10rpx;
  box-shadow: 0 6rpx 20rpx #dedfd6;
  padding: 20rpx 24rpx 24rpx;
  margin: 4rpx 0 20rpx;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.sheet-title {
  font-size: 27rpx;
  font-weight: 500;
  color: #292b25;
}

.sheet-close {
  font-size: 23rpx;
  color: #a83d30;
  padding: 6rpx 0 6rpx 20rpx;
}

.sheet-search {
  background: #f7f6f2;
  border: 1rpx solid #dedfd6;
  border-radius: 8rpx;
  padding: 0 20rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #292b25;
}

.placeholder {
  color: #8a8b82;
}

/* 结果条数只在浮层内出现 */
.filter-summary {
  font-size: 21rpx;
  color: #8a8b82;
  text-align: right;
  padding: 12rpx 0 4rpx;
}

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 76rpx;
  border-bottom: 1rpx solid #dedfd6;
  font-size: 25rpx;
}

.filter-value {
  color: #a83d30;
  max-width: 60%;
  text-align: right;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.sheet-reset, .sheet-done {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 16rpx 0;
  border-radius: 6rpx;
  border: 1rpx solid #dedfd6;
}

.sheet-reset {
  color: #5c5f56;
}

.sheet-done {
  color: #a83d30;
  border-color: #a83d30;
}

.state-card {
  padding: 80rpx 20rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 28rpx;
  color: #292b25;
}

.state-description {
  display: block;
  font-size: 24rpx;
  color: #8a8b82;
  margin-top: 12rpx;
}

.outline-button {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid #a83d30;
  border-radius: 6rpx;
  color: #a83d30;
  font-size: 25rpx;
}

.day-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 0 8rpx;
}

.day-text {
  font-size: 21rpx;
  color: #8a8b82;
}

.day-rule {
  flex: 1;
  height: 1rpx;
  background: #dedfd6;
}

.news-item {
  padding: 20rpx 0 22rpx;
  border-bottom: 1rpx solid #dedfd6;
}

.news-item.is-read .news-title {
  color: #8a8b82;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

/* 类型 / ASO 标签：默认中性灰，朱红只表示「真实事件」与「高风险」 */
.kind, .aso {
  font-size: 19rpx;
  padding: 3rpx 10rpx;
  border-radius: 4rpx;
  background: #efeee8;
  color: #5c5f56;
  border: 1rpx solid #dedfd6;
}

.kind-incident, .aso-high {
  background: #a83d30;
  color: #ffffff;
  border-color: #a83d30;
}

.kind-advisory, .kind-research, .aso-mid, .aso-low {
  background: #efeee8;
  color: #5c5f56;
}

.meta-source, .meta-date {
  font-size: 19rpx;
  color: #8a8b82;
}

.news-title {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 500;
  color: #292b25;
}

.news-summary {
  font-size: 25rpx;
  line-height: 1.55;
  color: #5c5f56;
  margin-top: 8rpx;
}
