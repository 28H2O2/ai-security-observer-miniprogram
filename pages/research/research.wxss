.masthead {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 18rpx;
}

.jade-logo {
  width: 56rpx;
  height: 68rpx;
  flex: none;
}

.brand-copy {
  min-width: 0;
}

.site-title {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.3;
  color: #292b25;
}

.snapshot {
  font-size: 20rpx;
  color: #8a8b82;
  margin-top: 6rpx;
}

.search-box {
  background: #edeee7;
  border-radius: 6rpx;
  padding: 0 20rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.search-input {
  width: 100%;
  font-size: 26rpx;
  color: #292b25;
}

.placeholder {
  color: #999b92;
}

.topic-row {
  display: flex;
  flex-direction: row;
  overflow-x: auto;
  white-space: nowrap;
  width: 100%;
  margin: 16rpx 0 4rpx;
}

.topic {
  display: inline-block;
  flex: none;
  padding: 10rpx 20rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  font-size: 23rpx;
  color: #66695f;
  background: #edeee7;
}

.topic.active {
  color: #ffffff;
  background: #a83d30;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #dedfd6;
}

.result-count {
  font-size: 22rpx;
  color: #66695f;
}

.filter-hint {
  font-size: 23rpx;
  color: #a83d30;
}

.filter-panel {
  background: #efeee8;
  border-radius: 8rpx;
  padding: 8rpx 20rpx 20rpx;
  margin-bottom: 12rpx;
}

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 76rpx;
  border-bottom: 1rpx solid #dedfd6;
  font-size: 25rpx;
}

.filter-value {
  color: #a83d30;
  max-width: 60%;
  text-align: right;
}

.filter-reset {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #66695f;
  padding: 14rpx;
  border: 1rpx solid #dedfd6;
  border-radius: 6rpx;
}

.state-card {
  padding: 80rpx 20rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 28rpx;
  color: #292b25;
}

.state-description {
  display: block;
  font-size: 24rpx;
  color: #66695f;
  margin-top: 12rpx;
}

.outline-button {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid #a83d30;
  border-radius: 6rpx;
  color: #a83d30;
  font-size: 25rpx;
}

.day-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0 8rpx;
}

.day-text {
  font-size: 21rpx;
  color: #8a8b82;
}

.day-rule {
  flex: 1;
  height: 1rpx;
  background: #dedfd6;
}

.news-item {
  padding: 20rpx 0 22rpx;
  border-bottom: 1rpx solid #dedfd6;
}

.news-item.is-read .news-title {
  color: #77796f;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.kind {
  font-size: 19rpx;
  padding: 3rpx 10rpx;
  border-radius: 4rpx;
  color: #ffffff;
}

.kind-incident { background: #a83d30; }
.kind-advisory { background: #a9761c; }
.kind-research { background: #4f6546; }

.meta-source, .meta-date {
  font-size: 19rpx;
  color: #8a8b82;
}

.aso {
  font-size: 19rpx;
  padding: 3rpx 10rpx;
  border-radius: 4rpx;
  color: #ffffff;
}

.aso-high { background: #a83d30; }
.aso-mid { background: #a9761c; }
.aso-low { background: #3c5a80; }

.news-title {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 500;
  color: #292b25;
}

.news-summary {
  font-size: 25rpx;
  line-height: 1.55;
  color: #77796f;
  margin-top: 8rpx;
}
