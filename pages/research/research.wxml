<view class="page-shell">
  <view class="masthead">
    <image class="jade-logo" src="/assets/jade-logo.png" mode="aspectFit"></image>
    <view class="brand-copy">
      <view class="site-title">AI 安全观察</view>
      <view class="snapshot">{{total}} 条 · 资料更新 {{updatedAt}}</view>
    </view>
  </view>

  <view class="search-box">
    <input class="search-input" value="{{q}}" bindinput="onSearch" confirm-type="search" placeholder="搜索情报或 CVE 编号" placeholder-class="placeholder" />
    <view wx:if="{{filterActive}}" class="filter-dot"></view>
    <text class="filter-entry" bindtap="toggleFilter">{{filterHint}}</text>
  </view>

  <view class="topic-row">
    <view wx:for="{{topicList}}" wx:key="id" class="{{item.className}}" data-value="{{item.id}}" bindtap="onTopic">{{item.label}}</view>
  </view>

  <view wx:if="{{filterOpen}}" class="filter-panel">
    <view class="filter-summary">{{resultText}}</view>
    <picker mode="selector" range="{{sourceLabels}}" value="{{sourceIndex}}" bindchange="onPicker" data-key="source">
      <view class="filter-row"><text>来源</text><text class="filter-value">{{sourceLabel}}</text></view>
    </picker>
    <picker mode="selector" range="{{evidenceLabels}}" value="{{evidenceIndex}}" bindchange="onPicker" data-key="evidence">
      <view class="filter-row"><text>资料类型</text><text class="filter-value">{{evidenceLabel}}</text></view>
    </picker>
    <picker mode="selector" range="{{periodLabels}}" value="{{periodIndex}}" bindchange="onPicker" data-key="period">
      <view class="filter-row"><text>时间范围</text><text class="filter-value">{{periodLabel}}</text></view>
    </picker>
    <picker mode="selector" range="{{assessmentLabels}}" value="{{assessmentIndex}}" bindchange="onPicker" data-key="assessment">
      <view class="filter-row"><text>风险评估</text><text class="filter-value">{{assessmentLabel}}</text></view>
    </picker>
    <picker mode="selector" range="{{sortLabels}}" value="{{sortIndex}}" bindchange="onPicker" data-key="sort">
      <view class="filter-row"><text>排序</text><text class="filter-value">{{sortLabel}}</text></view>
    </picker>
    <view class="filter-row">
      <text>只看未读</text>
      <switch checked="{{unread}}" bindchange="onUnread" color="#a83d30" />
    </view>
    <view class="filter-reset" bindtap="resetFilters">清空筛选</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-title">正在载入情报…</text>
  </view>
  <view wx:if="{{errorState}}" class="state-card">
    <text class="state-title">暂时无法载入资料</text>
    <text class="state-description">{{errorText}}</text>
    <view class="outline-button" bindtap="handleRetry">重新加载</view>
  </view>
  <view wx:if="{{emptyState}}" class="state-card">
    <text class="state-title">没有匹配结果</text>
    <view class="outline-button" bindtap="resetFilters">清空筛选</view>
  </view>

  <view wx:if="{{ready}}" class="feed-list">
    <view wx:for="{{cards}}" wx:key="id" wx:for-item="card">
      <view wx:if="{{card.dayHeading}}" class="day-label">
        <text class="day-text">{{card.dayHeading}}</text>
        <view class="day-rule"></view>
      </view>
      <view class="{{card.itemClass}}" bindtap="openItem" data-id="{{card.id}}">
        <view class="article-meta">
          <text wx:if="{{card.showKind}}" class="{{card.kindClass}}">{{card.kindLabel}}</text>
          <text class="meta-source">{{card.sourceName}}</text>
          <text wx:if="{{card.showDate}}" class="meta-date">{{card.dateText}}</text>
          <text wx:if="{{card.asoText}}" class="{{card.asoClassName}}">{{card.asoText}}</text>
        </view>
        <view class="news-title">{{card.title}}</view>
        <view wx:if="{{card.briefSummary}}" class="news-summary">{{card.briefSummary}}</view>
      </view>
    </view>
  </view>
</view>
