/* 列表页样式：调色板与语义规则见 app.wxss 顶部注释
   全工程只有一个强调色（朱红），其余均为纸色灰阶 */

.masthead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0 20rpx;
}

/* LOGO 放大，作为品牌区视觉重心 */
.jade-logo {
  width: 88rpx;
  height: 108rpx;
  flex: none;
}

.brand-copy {
  min-width: 0;
}

.site-title {
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.3;
  color: #292b25;
}

.snapshot {
  font-size: 20rpx;
  color: #8a8b82;
  margin-top: 6rpx;
}

/* 搜索：白底细边框。筛选入口并入同一行，不单独占工具栏 */
.search-box {
  background: #ffffff;
  border: 1rpx solid #dedfd6;
  border-radius: 8rpx;
  padding: 0 20rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #292b25;
}

.placeholder {
  color: #8a8b82;
}

/* 筛选入口收缩为中性灰滑块 icon：无文字、无分隔线、不占主位置。
   仅在面板展开或已有筛选条件时变朱红（当前选中 / 可点击语义） */
.filter-icon {
  flex: none;
  align-self: stretch;
  width: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
}

.icon-track {
  width: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.icon-bar {
  width: 16rpx;
  height: 2rpx;
  background: #8a8b82;
}

.icon-knob {
  width: 9rpx;
  height: 9rpx;
  border: 2rpx solid #8a8b82;
  border-radius: 50%;
  box-sizing: border-box;
}

.filter-icon.is-active .icon-bar {
  background: #a83d30;
}

.filter-icon.is-active .icon-knob {
  border-color: #a83d30;
  background: #a83d30;
}

/* 主题：换行排列，不再横向滚动（避免预览里的滚动条）；
   选中态只用朱红边框与文字，不铺色块 */
.topic-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 14rpx;
}

.topic {
  flex: none;
  padding: 8rpx 18rpx;
  border: 1rpx solid #dedfd6;
  border-radius: 6rpx;
  font-size: 23rpx;
  color: #5c5f56;
  background: #ffffff;
}

.topic.active {
  color: #a83d30;
  border-color: #a83d30;
  font-weight: 500;
}

/* 结果条数只在展开筛选面板时出现 */
.filter-panel {
  background: #efeee8;
  border-radius: 8rpx;
  padding: 8rpx 20rpx 20rpx;
  margin-bottom: 12rpx;
}

.filter-summary {
  font-size: 21rpx;
  color: #8a8b82;
  text-align: right;
  padding: 12rpx 0 4rpx;
}

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 76rpx;
  border-bottom: 1rpx solid #dedfd6;
  font-size: 25rpx;
}

.filter-value {
  color: #a83d30;
  max-width: 60%;
  text-align: right;
}

.filter-reset {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #5c5f56;
  padding: 14rpx;
  border: 1rpx solid #dedfd6;
  border-radius: 6rpx;
}

.state-card {
  padding: 80rpx 20rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 28rpx;
  color: #292b25;
}

.state-description {
  display: block;
  font-size: 24rpx;
  color: #8a8b82;
  margin-top: 12rpx;
}

.outline-button {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid #a83d30;
  border-radius: 6rpx;
  color: #a83d30;
  font-size: 25rpx;
}

.day-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 0 8rpx;
}

.day-text {
  font-size: 21rpx;
  color: #8a8b82;
}

.day-rule {
  flex: 1;
  height: 1rpx;
  background: #dedfd6;
}

.news-item {
  padding: 20rpx 0 22rpx;
  border-bottom: 1rpx solid #dedfd6;
}

.news-item.is-read .news-title {
  color: #8a8b82;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

/* 类型 / ASO 标签：默认中性灰，朱红只表示「真实事件」与「高风险」 */
.kind, .aso {
  font-size: 19rpx;
  padding: 3rpx 10rpx;
  border-radius: 4rpx;
  background: #efeee8;
  color: #5c5f56;
  border: 1rpx solid #dedfd6;
}

.kind-incident, .aso-high {
  background: #a83d30;
  color: #ffffff;
  border-color: #a83d30;
}

.kind-advisory, .kind-research, .aso-mid, .aso-low {
  background: #efeee8;
  color: #5c5f56;
}

.meta-source, .meta-date {
  font-size: 19rpx;
  color: #8a8b82;
}

.news-title {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 500;
  color: #292b25;
}

.news-summary {
  font-size: 25rpx;
  line-height: 1.55;
  color: #5c5f56;
  margin-top: 8rpx;
}
