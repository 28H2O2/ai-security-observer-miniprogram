/* ── 调色板与语义规则 ────────────────────────────────
   纸底 #f7f6f2  页面背景
   浅块 #efeee8  面板、筛选区、标签底
   白   #ffffff  输入区、卡片浮层
   墨   #292b25  标题与主要信息
   正文 #5c5f56  摘要与正文
   次要 #8a8b82  元信息、日期、说明
   线   #dedfd6  分隔线与边框
   朱红 #a83d30  【唯一强调色】只表达四类含义：
        ① 当前选中  ② 真实发生的攻击事件
        ③ 高风险 / 高权重  ④ 可点击操作
   其余类型与等级一律中性灰，靠文字区分，不靠颜色。
   ─────────────────────────────────────────────────── */

page {
  min-height: 100%;
  background: #f7f6f2;
  color: #292b25;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  border-radius: 6rpx;
  font-size: 28rpx;
}

button::after {
  border: none;
}

.page-shell {
  padding: 0 28rpx 60rpx;
}

.text-muted {
  color: #5c5f56;
}

.rule-line {
  height: 1rpx;
  background: #dedfd6;
}
