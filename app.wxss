page {
  min-height: 100%;
  background: #f7f6f2;
  color: #292b25;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  border-radius: 6rpx;
  font-size: 28rpx;
}

button::after {
  border: none;
}

.page-shell {
  padding: 0 28rpx 60rpx;
}

.text-muted {
  color: #66695f;
}

.rule-line {
  height: 1rpx;
  background: #dedfd6;
}
